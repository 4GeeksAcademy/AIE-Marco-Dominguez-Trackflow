{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:4173/",
        "http://localhost:4173/application.html"
      ],
      "numberOfRuns": 3,
      "settings": {
        "formFactor": "mobile",
        "throttlingMethod": "simulate",
        "chromeFlags": "--no-sandbox --disable-dev-shm-usage"
      },
      "startServerCommand": "npm run build:css && npx serve@14 . --listen 4173",
      "startServerReadyPattern": "Accepting connections at http://localhost:4173"
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.8 }],
        "categories:best-practices": ["error", { "minScore": 0.8 }],
        "categories:seo": ["error", { "minScore": 0.8 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./docs/audits/lighthouse-results"
    }
  }
}